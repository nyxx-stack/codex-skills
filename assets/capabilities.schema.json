{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/capabilities.schema.json",
  "title": "Agent CLI Capabilities",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "version",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "risk",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "read_only",
              "local_write",
              "remote_write",
              "destructive",
              "regulated"
            ]
          },
          "description": {
            "type": "string"
          },
          "input_schema_ref": {
            "type": "string"
          },
          "output_schema_ref": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}