{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent_cli_contract.schema.json",
  "title": "Agent CLI Success Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command",
    "data",
    "artifacts",
    "warnings",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "ok": {
      "const": true
    },
    "command": {
      "type": "string"
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}